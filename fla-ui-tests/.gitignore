bin/
obj/
artifacts/
*.user
.vs/
TestResults/

# Nhật ký + kết quả của mỗi lần chạy — sinh lại được, đừng commit.
logs/
treatment-grid-*.txt
# Mỗi luồng probe đẻ ra một file <tên-luồng>-KQ.txt. Trước đây liệt kê từng tên nên
# luồng mới lại lọt vào `git status` của máy chạy test (máy Windows) — bắt hết bằng
# một luật thay vì thêm tay từng dòng.
*-KQ.txt
*.trx

# testsettings.local.json là file RIÊNG CỦA TỪNG MÁY: đường dẫn MENU.exe, chuỗi kết
# nối SQL Server, bệnh nhân/ngày test, timeout — mỗi máy một khác. Trước đây nó bị
# commit (dòng `!testsettings.*.json` cũ vô hiệu hoá mọi ignore), gây hai chuyện:
#   · hai máy sửa cùng file ⇒ conflict mỗi lần pull;
#   · mật khẩu `sa` nằm trong repo.
# Bản mẫu để người mới copy là testsettings.local.json.example (VẪN commit).
testsettings.local.json

# testsettings.json là cấu hình CHUNG, phải commit.
!testsettings.json
!testsettings.local.json.example
